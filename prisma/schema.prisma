generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  supabaseId   String?  @unique
  avatarUrl    String?
  passwordHash String
  role         String   @default("USER")
  balance      Float    @default(0)
  currency     String   @default("USDT")
  apiKey       String?  @unique
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  payments     Payment[]
  tickets      Ticket[]
  ticketReplies TicketReply[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id                String   @id @default(cuid())
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  name              String
  description       String
  type              String   @default("Default")
  rate              Float
  min               Int
  max               Int
  refill            Boolean  @default(false)
  dripfeed          Boolean  @default(false)
  cancel            Boolean  @default(false)
  averageTime       String   @default("0-24 hours")
  status            String   @default("active")
  providerServiceId Int?     @unique
  providerRate      Float    @default(0)
  orders            Order[]
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  link            String
  quantity        Int
  charge          Float
  startCount      Int      @default(0)
  remains         Int      @default(0)
  status          String   @default("PENDING")
  providerOrderId String?
  providerRefillId String?
  runs            Int?
  interval        Int?
  extras          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Float
  paidAmount Float    @default(0)
  currency   String
  method     String
  status     String   @default("PENDING")
  reference  String   @unique
  note       String?
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Ticket {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  subject   String
  status    String        @default("OPEN")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  fileUrl   String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}
